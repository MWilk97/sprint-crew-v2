# HuggingFace — required for model download inside Docker (GX10 / vLLM only)
HF_TOKEN=hf_xxxxxxxx
HUGGING_FACE_HUB_TOKEN=${HF_TOKEN}

# HuggingFace model cache (shared by vLLM lanes). Omit to use defaults below.
# HF_HOME=$HOME/vllm-models
# HF_CACHE_DIR=$HOME/.cache/huggingface

# vLLM lanes (defaults — override in infra/models.yaml)
# Work lane (:8002) is shared by ScrumMaster (prep), TechLead, Formatter, and Reviewer.
VLLM_CODER_URL=http://127.0.0.1:8001/v1
VLLM_WORK_URL=http://127.0.0.1:8002/v1
# Legacy alias still accepted: VLLM_PLANNER_URL

# Opt-in live test flags (export before pytest)
# INTEGRATION_LIVE=1
# VLLM_LIVE=1
# PREFLIGHT_LIVE=1

# --- Sandbox integration (Tier 2) ---
# Set USE_MOCK_INTEGRATIONS=false and fill credentials below for live Jira/GitHub tests.
# Run: ./scripts/setup_integration_sandbox.sh

USE_MOCK_INTEGRATIONS=true

# Jira sandbox project (dedicated test project, not production)
# JIRA_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SCRUM
# JIRA_REVIEW_TRANSITION=W trakcie weryfikacji
# JIRA_AC_FIELD=customfield_10016

# GitHub sandbox (PAT with repo scope)
# GITHUB_TOKEN=
# GITHUB_REPO=owner/sandbox-main

# Fixture sandbox: main branch = fixtures/repo (greeter + validators tests).
# Required for ship_live_cycles and GX10 GPU tests.
# GITHUB_FIXTURE_REPO_GREETER=owner/sprint-fixture-greeter

# MAX_REVIEW_RETRIES=4
# MAX_PLAN_RETRIES=1
# CODER_STEP_MODE=true
# CODER_EARLY_EXIT_REQUIRES_COVERAGE=true
# MAX_COVERAGE_ROUNDS=2
# MAX_TECHLEAD_TURNS=12
# MAX_WRITE_FILE_BYTES=65536

# Vector index (Qdrant + embed sidecar) — on by default; unit tests force VECTOR_INDEX_ENABLED=false
# VECTOR_INDEX_ENABLED=true
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION_PREFIX=code_chunks
# EMBED_URL=http://127.0.0.1:8080/v1
# EMBED_MODEL_ID=jinaai/jina-embeddings-v2-base-code
# VECTOR_TOP_K=8
# VECTOR_SCORE_THRESHOLD=0.55

# Local paths — omit to use portable defaults from config.py ($HOME/...)
# SPRINT_WORKSPACE_BASE=$HOME/sprint-workspaces
# SPRINT_CHECKPOINT_DB=$HOME/.sprint-crew/checkpoints.db
# SPRINT_SESSION_DB=$HOME/.sprint-crew/sessions.db
