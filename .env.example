# HuggingFace — required for model download inside Docker (GX10 / vLLM only)
HF_TOKEN=hf_xxxxxxxx
HUGGING_FACE_HUB_TOKEN=${HF_TOKEN}

# HuggingFace model cache (shared by vLLM lanes). Omit to use defaults below.
# HF_HOME=$HOME/vllm-models
# HF_CACHE_DIR is read only by docker-compose, not by config.py:
# HF_CACHE_DIR=$HOME/.cache/huggingface

# vLLM lanes (defaults — override in infra/models.yaml)
# Work lane (:8002) is shared by ScrumMaster (prep), TechLead, Formatter, and Reviewer.
VLLM_CODER_URL=http://127.0.0.1:8001/v1
VLLM_WORK_URL=http://127.0.0.1:8002/v1
# Legacy alias still accepted: VLLM_PLANNER_URL

# Console / sprint API auth (shared bearer). Empty or unset ⇒ auth disabled.
# When set, every /v1/console/* and /sprint/* request needs:
#   Authorization: Bearer <token>
# GET /health stays open for probes.
# CONSOLE_API_TOKEN=

# Console API CORS (browser console, ADR 0011). Comma-separated origins.
# Default "*" is DEV ONLY — set explicit origins before exposing the API.
# CONSOLE_CORS_ORIGINS=http://localhost:5173

# Console SSE stream (M3, GET /v1/console/sessions/{id}/stream).
# Heartbeat: seconds between ": ping" keepalive frames — survives proxy idle-reap
# and long GPU silences. Queue maxsize bounds per-subscriber memory; on overflow the
# slow subscriber is dropped and reconnects to replay from the events table.
# SSE_HEARTBEAT_S=15
# SSE_QUEUE_MAXSIZE=1000

# Structured diff snapshots (M6, GET /v1/console/sessions/{id}/diff). Captured once per
# review pass for console-backed runs only. A file over the byte cap is shortened and
# flagged rather than dropped; past the file cap, whole files are omitted.
# DIFF_SNAPSHOT_ENABLED=true
# DIFF_MAX_FILES=500
# DIFF_MAX_FILE_BYTES=200000

# Human review gate before ship (M7, POST /v1/console/sessions/{id}/diff/decisions). The
# parked run holds the single admission slot and its workspace, so the timeout is what
# stops an abandoned review from wedging the queue. Rejection rounds are budgeted apart
# from MAX_REVIEW_RETRIES; the next rejection after the last round ends the run.
# CONSOLE_REVIEW_GATE_ENABLED=true
# DIFF_REVIEW_TIMEOUT_S=3600
# MAX_USER_REJECTION_ROUNDS=3

# Opt-in live test flags (export before pytest). Both gate the agent_live trap test.
# VLLM_LIVE=1
# VECTOR_AGENT_LIVE=1

# --- Sandbox integration ---
# Set USE_MOCK_INTEGRATIONS=false and fill credentials below for live Jira/GitHub tests.

USE_MOCK_INTEGRATIONS=true

# Jira sandbox project (dedicated test project, not production)
# JIRA_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SCRUM
# JIRA_REVIEW_TRANSITION=In Review
# JIRA_AC_FIELD=customfield_10016

# GitHub sandbox (PAT with repo scope)
# GITHUB_TOKEN=
# GITHUB_REPO=owner/sandbox-main

# Fixture sandbox: main branch = fixtures/repo (greeter + validators tests).
# Required for ship_live_cycles and GX10 GPU tests.
# GITHUB_FIXTURE_REPO_GREETER=owner/sprint-fixture-greeter

# MAX_REVIEW_RETRIES=4
# MAX_PLAN_RETRIES=2
# MAX_BACKLOG_STORIES=5

# Wall-clock caps (seconds) on subprocesses that previously ran unbounded.
# ACCEPTANCE_TEST_TIMEOUT_S=900
# GIT_TIMEOUT_S=120

# Grace period after Stop before a run that ignored the cooperative cancel token is
# hard-cancelled. A body blocked in subprocess.run cannot see the token until it
# returns (ADR 0014).
# CANCEL_GRACE_S=30

# Console clarify (ADR 0013). Interpreter runs on the Work lane; when that lane is cold the
# backend serves deterministic questions instead of making an interactive caller wait.
# Set CLARIFY_AUTOSTART_LANE=true to load the lane on demand instead.
# CLARIFY_LLM_ENABLED=true
# CLARIFY_AUTOSTART_LANE=false
# MAX_CLARIFY_QUESTIONS=4
# INTERPRETER_TIMEOUT_S=120
# Measured on GX10: clarify takes 14.9s with thinking off vs 177.4s with it on, and the
# thinking answers were vaguer (see docs/model-evaluation.md probe E). Leave this off.
# Turning it on swaps to the longer deadline — 177s does not fit INTERPRETER_TIMEOUT_S.
# INTERPRETER_THINKING_ENABLED=false
# INTERPRETER_THINKING_TIMEOUT_S=600

# Grounded clarify (roadmap M9). The session owns a checkout from creation, so the
# Interpreter sees the repo and stops asking what it could have looked up. The cap keeps
# manifest + grep + pre-search inside the interactive deadline above.
# CLARIFY_REPO_CONTEXT_ENABLED=true
# INTERPRETER_REPO_CONTEXT_CHARS=12000

# Codebase chat (roadmap M9, ADR 0017). One read-only Explainer turn on the Work lane,
# holding the same single admission slot a run does — ensure_lane stops every other lane,
# so a run admitted mid-ask would take the lane away from it. Rejected with 409 while a run
# is live. There is deliberately no warm-lane policy: a cold ask pays the load and says so
# on the stream, so AGENTS.md §4.1 stands.
# CONSOLE_ASK_ENABLED=true
# MAX_EXPLAINER_TURNS=8
# EXPLAINER_TIMEOUT_S=300
# Answer text streams as coalesced answer_delta events — one per N chars or per interval,
# whichever trips first. Per-token events would be one SQLite row and one publish each.
# ANSWER_DELTA_CHARS=120
# ANSWER_DELTA_INTERVAL_S=0.25
# Citations link into files, so the console serves file contents read-only.
# CONSOLE_FILE_MAX_BYTES=262144

# CODER_STEP_MODE=true
# CODER_EARLY_EXIT_REQUIRES_COVERAGE=true
# MAX_COVERAGE_ROUNDS=2
# MAX_TECHLEAD_TURNS=12
# MAX_WRITE_FILE_BYTES=65536
# MAX_CODER_TURNS=32
# MAX_TESTER_TURNS=32

# Coder (Laguna S 2.1) sampling — Poolside eval-certified defaults; leave unless benchmarking.
# CODER_TEMPERATURE=0.7
# CODER_TOP_P=0.95
# CODER_TOP_K=20
# Reasoning escalation: thinking off until this attempt, then on with the longer timeout.
# CODER_THINKING_ENABLED=true
# CODER_THINKING_ESCALATION_ATTEMPT=2
# CODER_REQUEST_TIMEOUT_S=600
# CODER_THINKING_TIMEOUT_S=1800

# Trap tier is STRICT by default (falling for a trap fails the test).
# VECTOR_TRAP_SOFT=1   # report-only benchmark runs (does not go red on trap failure)

# Vector index (Qdrant + embed sidecar) — on by default; unit tests force VECTOR_INDEX_ENABLED=false
# VECTOR_INDEX_ENABLED=true
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION_PREFIX=code_chunks
# EMBED_URL=http://127.0.0.1:8080/v1
# EMBED_MODEL_ID=jinaai/jina-embeddings-v2-base-code
# VECTOR_TOP_K=8
# VECTOR_SCORE_THRESHOLD=0.55
# Repo-keyed collections outlive their runs (M8), so an LRU cap bounds Qdrant. 0 = no cap.
# VECTOR_MAX_COLLECTIONS=10
# Drop prefixed collections the index manifest does not know (pre-M8 leftovers, dead overlays).
# VECTOR_ORPHAN_SWEEP=true

# Local paths — omit to use portable defaults from config.py ($HOME/...)
# SPRINT_WORKSPACE_BASE=$HOME/sprint-workspaces
# Clone depth for workspaces; deeper than 1 so the agents' git_log tool has history to read.
# GIT_CLONE_DEPTH=50
# SPRINT_CHECKPOINT_DB=$HOME/.sprint-crew/checkpoints.db
# SPRINT_SESSION_DB=$HOME/.sprint-crew/sessions.db
# Console sessions older than this are reaped on the next sweep.
# CONSOLE_SESSION_TTL_DAYS=14
# A console session clones and indexes its repo at creation (M8). Turn either off to keep
# session creation free of git and the embed sidecar.
# CONSOLE_WORKSPACE_ON_CREATE=true
# CONSOLE_INDEX_ON_CREATE=true
# Beyond this many workspaces, terminal sessions' clones are evicted least-recently-used first.
# CONSOLE_MAX_WORKSPACES=10
