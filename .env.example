# HuggingFace — required for model download inside Docker
HF_TOKEN=hf_xxxxxxxx
HUGGING_FACE_HUB_TOKEN=${HF_TOKEN}

# HuggingFace model cache (shared by vLLM lanes)
HF_HOME=/home/maciek/vllm-models

# vLLM lanes (defaults — override in infra/models.yaml)
VLLM_CODER_URL=http://127.0.0.1:8001/v1
VLLM_PLANNER_URL=http://127.0.0.1:8002/v1
VLLM_JUDGE_URL=http://127.0.0.1:8003/v1
TEI_EMBED_URL=http://127.0.0.1:8080

# Preflight probes (opt-in live tests)
# PREFLIGHT_LIVE=1

# Jira / GitHub (Phase 4+)
# JIRA_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# GITHUB_TOKEN=
